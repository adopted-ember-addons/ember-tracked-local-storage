{
  "name": "ember-tracked-local-storage",
  "version": "2.0.1",
  "description": "For all your tracked local storage needs, when updating values held in browser storage should trigger a template rerender.",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:adopted-ember-addons/ember-tracked-local-storage.git"
  },
  "license": "MIT",
  "author": "",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./*.css": "./dist/*.css",
    "./*": {
      "default": "./dist/*.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup --config",
    "build:docs": "vite build --out-dir dist-docs",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:publish": "pnpm build && publint run --level error",
    "prepack": "rollup --config",
    "start": "vite dev",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.3",
    "decorator-transforms": "^2.4.0",
    "macro-decorators": "^0.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/runtime": "^7.29.7",
    "@ember/app-tsconfig": "^1.0.3",
    "@ember/library-tsconfig": "^1.1.3",
    "@ember/test-helpers": "^5.5.2",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/addon-dev": "^8.4.0",
    "@embroider/compat": "^4.1.25",
    "@embroider/core": "^4.6.7",
    "@embroider/macros": "^1.21.1",
    "@embroider/vite": "^1.7.13",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.1.1",
    "@release-it-plugins/lerna-changelog": "^5.0.0",
    "@rollup/plugin-babel": "^6.1.0",
    "autoprefixer": "^10.6.1",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.4",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.2.0",
    "ember-source": "^6.12.0",
    "ember-strict-application-resolver": "^0.1.1",
    "ember-template-lint": "^7.9.3",
    "ember-window-mock": "^2.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "prismjs": "^1.30.0",
    "publint": "^0.3.24",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "release-it": "^15.11.0",
    "rollup": "^4.63.5",
    "tailwindcss": "^3.4.19",
    "testem": "^3.21.2",
    "vite": "^7.3.6"
  },
  "peerDependencies": {
    "ember-source": ">= 4.12.0"
  },
  "packageManager": "pnpm@10.13.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./services/tracked-local-storage.js": "./dist/_app_/services/tracked-local-storage.js",
      "./utils/tracked-in-local-storage.js": "./dist/_app_/utils/tracked-in-local-storage.js"
    }
  },
  "release-it": {
    "plugins": {
      "@release-it-plugins/lerna-changelog": {
        "infile": "CHANGELOG.md",
        "launchEditor": true
      }
    },
    "git": {
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "tokenRef": "GITHUB_AUTH"
    }
  }
}
